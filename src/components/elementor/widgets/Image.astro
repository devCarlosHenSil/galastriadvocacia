---
/**
 * The image widget (SPEC-UI §1.2).
 */
import type { ElementorNode } from '~/lib/elementor';
import { imageSize } from '~/lib/image';
import { asset } from '~/lib/assets';

interface Props {
  node: ElementorNode;
}

const { node } = Astro.props;
const image = node.settings.image ?? {};
const url = String(image.url ?? '');
const size = imageSize(url);
const link = node.settings.link_to === 'custom' ? node.settings.link?.url : undefined;
const alt = String(image.alt ?? '');
// An image without an alternative text is decorative: it is hidden from the
// accessibility tree — U21b.
const decorative = alt.trim() === '';
---

{
  link ? (
    <a href={link}>
      <img
        src={asset(url)}
        alt={alt}
        aria-hidden={decorative ? 'true' : undefined}
        class={`attachment-full size-full${image.id ? ` wp-image-${image.id}` : ''}`}
        width={size?.width}
        height={size?.height}
        loading="lazy"
        decoding="async"
      />
    </a>
  ) : (
    <img
      src={asset(url)}
      alt={alt}
      aria-hidden={decorative ? 'true' : undefined}
      class={`attachment-full size-full${image.id ? ` wp-image-${image.id}` : ''}`}
      width={size?.width}
      height={size?.height}
      loading="lazy"
      decoding="async"
    />
  )
}
